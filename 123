<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>迪士尼夢幻星光記憶翻牌遊戲</title>
    <!-- 引入 Google Fonts 繁體中文圓體與優雅襯線字體 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* 自訂童話夢幻主題樣式 */
        :root {
            --disney-gold: #ffd700;
            --disney-gold-light: #fff3b0;
            --disney-night-deep: #070b19;
            --disney-night-mid: #101b3d;
            --disney-royal-blue: #1e3a8a;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        body {
            font-family: 'Noto Sans TC', sans-serif;
            background: radial-gradient(ellipse at top, #172a5e 0%, #0b132b 55%, #050814 100%);
            color: #f8fafc;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* 背景星光粒子畫布 */
        #starfield-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        /* 慶祝彩帶畫布 */
        #confetti-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 100;
        }

        /* 魔法標題光暈 */
        .magic-title {
            background: linear-gradient(135deg, #fff6cc 0%, #ffd700 45%, #f59e0b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 12px rgba(255, 215, 0, 0.45));
        }

        /* 玻璃擬態面板 */
        .glass-panel {
            background: rgba(16, 27, 61, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 215, 0, 0.25);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 0 15px rgba(255, 215, 0, 0.08);
        }

        /* 魔法按鈕特效 */
        .magic-btn {
            background: linear-gradient(135deg, rgba(30, 58, 138, 0.85), rgba(49, 46, 129, 0.9));
            border: 1px solid rgba(255, 215, 0, 0.4);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.2);
            transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .magic-btn:hover {
            transform: translateY(-2px);
            border-color: #ffd700;
            box-shadow: 0 6px 20px rgba(255, 215, 0, 0.3), inset 0 1px 2px rgba(255, 255, 255, 0.4);
        }

        .magic-btn:active {
            transform: translateY(1px) scale(0.97);
        }

        .magic-btn.active-diff {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #090d16;
            font-weight: 800;
            border-color: #fef08a;
            box-shadow: 0 0 18px rgba(245, 158, 11, 0.6);
        }

        /* 3D 翻牌容器與卡片結構 */
        .card-scene {
            perspective: 1000px;
            aspect-ratio: 3 / 4;
            width: 100%;
            cursor: pointer;
        }

        .card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.6s cubic-bezier(0.34, 1.4, 0.64, 1);
            transform-style: preserve-3d;
        }

        .card-scene.is-flipped .card-inner,
        .card-scene.is-matched .card-inner {
            transform: rotateY(180deg);
        }

        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            border-radius: 1rem;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
        }

        /* 牌背面：皇家星夜藍與魔法金徽章 */
        .card-back {
            background: linear-gradient(145deg, #172554 0%, #1e1b4b 50%, #0f172a 100%);
            border: 2px solid rgba(255, 215, 0, 0.55);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        /* 牌背微光掃過動畫 */
        .card-back::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent 40%,
                rgba(255, 215, 0, 0.14) 50%,
                transparent 60%
            );
            animation: cardShimmer 4.5s infinite linear;
            pointer-events: none;
        }

        /* 牌背內框線 */
        .card-back::after {
            content: '';
            position: absolute;
            inset: 6px;
            border: 1px dashed rgba(255, 215, 0, 0.35);
            border-radius: 0.7rem;
            pointer-events: none;
        }

        @keyframes cardShimmer {
            0% { transform: translateX(-30%) translateY(-30%) rotate(0deg); }
            100% { transform: translateX(30%) translateY(30%) rotate(0deg); }
        }

        .card-scene:not(.is-flipped):not(.is-matched):hover .card-back {
            border-color: #ffd700;
            box-shadow: 0 0 18px rgba(255, 215, 0, 0.45);
        }

        /* 牌正面：角色插畫卡片 */
        .card-front {
            transform: rotateY(180deg);
            border: 2px solid #ffd700;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 0.45rem 0.35rem;
        }

        /* 配對成功魔法發光動畫 */
        .card-scene.is-matched .card-front {
            animation: matchGlow 0.9s ease-out forwards;
            border-color: #ffffff;
        }

        @keyframes matchGlow {
            0% {
                box-shadow: 0 0 5px #ffd700;
                transform: rotateY(180deg) scale(1);
            }
            45% {
                box-shadow: 0 0 30px #ffd700, 0 0 55px #60a5fa;
                transform: rotateY(180deg) scale(1.06);
            }
            100% {
                box-shadow: 0 0 14px rgba(255, 215, 0, 0.65);
                transform: rotateY(180deg) scale(1);
            }
        }

        /* 錯誤搖晃動畫 */
        @keyframes cardShake {
            0%, 100% { transform: rotateY(180deg) translateX(0); }
            25% { transform: rotateY(180deg) translateX(-5px); }
            75% { transform: rotateY(180deg) translateX(5px); }
        }

        .card-scene.is-wrong .card-inner {
            animation: cardShake 0.35s ease-in-out;
        }

        /* 閃爍星星粒子 DOM 特效 */
        .sparkle-burst {
            position: fixed;
            pointer-events: none;
            z-index: 60;
            animation: sparklePop 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes sparklePop {
            0% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(0.2) rotate(0deg);
            }
            60% {
                opacity: 1;
            }
            100% {
                opacity: 0;
                transform: translate(var(--tx), var(--ty)) scale(1.1) rotate(180deg);
            }
        }

        /* 彈出視窗動畫 */
        .modal-backdrop {
            background: rgba(5, 8, 20, 0.82);
            backdrop-filter: blur(8px);
            transition: opacity 0.3s ease;
        }

        .modal-card {
            animation: modalFloatIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        @keyframes modalFloatIn {
            0% { opacity: 0; transform: scale(0.8) translateY(20px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }
    </style>
</head>
<body class="flex flex-col items-center justify-between py-4 px-3 sm:px-6">

    <!-- 背景魔法星光畫布 -->
    <canvas id="starfield-canvas"></canvas>
    <!-- 過關彩帶畫布 -->
    <canvas id="confetti-canvas"></canvas>

    <!-- 頂部標題與控制區 -->
    <header class="relative z-10 w-full max-w-4xl flex flex-col items-center gap-3 mb-3">
        <!-- 城堡皇冠裝飾與遊戲主標題 -->
        <div class="flex items-center justify-center gap-2 sm:gap-3 text-center">
            <svg class="w-7 h-7 sm:w-9 sm:h-9 text-amber-300 drop-shadow-[0_0_8px_rgba(255,215,0,0.8)]" viewBox="0 0 64 64" fill="currentColor">
                <path d="M32 6l4 10h10l-8 6 3 10-9-6-9 6 3-10-8-6h10z"/>
                <path d="M14 54V34l6-6 6 6v20H14zm24 0V34l6-6 6 6v20H38zM24 54V26l8-8 8 8v28H24z" opacity="0.9"/>
                <rect x="10" y="54" width="44" height="4" rx="2"/>
            </svg>
            <h1 class="text-2xl sm:text-4xl font-black tracking-wider magic-title">
                迪士尼夢幻記憶翻牌
            </h1>
            <svg class="w-7 h-7 sm:w-9 sm:h-9 text-amber-300 drop-shadow-[0_0_8px_rgba(255,215,0,0.8)]" viewBox="0 0 64 64" fill="currentColor">
                <path d="M32 6l4 10h10l-8 6 3 10-9-6-9 6 3-10-8-6h10z"/>
                <path d="M14 54V34l6-6 6 6v20H14zm24 0V34l6-6 6 6v20H38zM24 54V26l8-8 8 8v28H24z" opacity="0.9"/>
                <rect x="10" y="54" width="44" height="4" rx="2"/>
            </svg>
        </div>

        <!-- 難度選擇與功能按鈕列 -->
        <div class="w-full flex flex-wrap items-center justify-between gap-2 glass-panel rounded-2xl px-3 py-2.5 sm:px-5">
            <!-- 難度切換按鈕組 -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <span class="text-xs sm:text-sm text-amber-200/80 font-medium hidden md:inline">魔法難度：</span>
                <button onclick="setDifficulty('easy')" id="btn-easy" class="magic-btn px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold text-amber-100">
                    簡單 (4×3)
                </button>
                <button onclick="setDifficulty('normal')" id="btn-normal" class="magic-btn active-diff px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold">
                    標準 (4×4)
                </button>
                <button onclick="setDifficulty('hard')" id="btn-hard" class="magic-btn px-3 py-1.5 rounded-xl text-xs sm:text-sm font-bold text-amber-100">
                    困難 (6×4)
                </button>
            </div>

            <!-- 操作按鈕組（重新開始 / 音效切換） -->
            <div class="flex items-center gap-2">
                <button onclick="toggleSound()" id="btn-sound" title="切換魔法音效" class="magic-btn p-2 rounded-xl text-amber-200 flex items-center justify-center">
                    <!-- 喇叭開啟圖示 -->
                    <svg id="icon-sound-on" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
                    </svg>
                    <!-- 靜音圖示 -->
                    <svg id="icon-sound-off" class="w-5 h-5 hidden text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/>
                    </svg>
                </button>

                <button onclick="restartGame()" class="magic-btn px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-bold text-amber-200 flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                    <span>重新開始</span>
                </button>
            </div>
        </div>

        <!-- 遊戲狀態數據面板 -->
        <div class="w-full grid grid-cols-4 gap-2 sm:gap-3">
            <div class="glass-panel rounded-xl py-2 px-2 sm:px-4 flex flex-col items-center justify-center">
                <span class="text-[11px] sm:text-xs text-blue-200/80">步數</span>
                <span id="stat-moves" class="text-lg sm:text-2xl font-black text-amber-300">0</span>
            </div>
            <div class="glass-panel rounded-xl py-2 px-2 sm:px-4 flex flex-col items-center justify-center">
                <span class="text-[11px] sm:text-xs text-blue-200/80">計時</span>
                <span id="stat-time" class="text-lg sm:text-2xl font-black text-sky-300 font-mono">00:00</span>
            </div>
            <div class="glass-panel rounded-xl py-2 px-2 sm:px-4 flex flex-col items-center justify-center">
                <span class="text-[11px] sm:text-xs text-blue-200/80">配對進度</span>
                <span id="stat-pairs" class="text-lg sm:text-2xl font-black text-emerald-300">0 / 8</span>
            </div>
            <div class="glass-panel rounded-xl py-2 px-2 sm:px-4 flex flex-col items-center justify-center">
                <span class="text-[11px] sm:text-xs text-blue-200/80">最佳步數</span>
                <span id="stat-best" class="text-lg sm:text-2xl font-black text-pink-300">--</span>
            </div>
        </div>
    </header>

    <!-- 卡片網格主遊戲區 -->
    <main class="relative z-10 w-full max-w-3xl flex-1 flex items-center justify-center my-1">
        <div id="game-board" class="w-full grid grid-cols-4 gap-2.5 sm:gap-3.5 transition-all duration-300">
            <!-- 卡片將由 JavaScript 動態生成 -->
        </div>
    </main>

    <!-- 底部提示文字 -->
    <footer class="relative z-10 mt-3 text-center text-xs text-blue-200/60">
        ✨ 點擊魔法卡牌尋找成雙成對的迪士尼夥伴 ✨
    </footer>

    <!-- 過關慶祝彈出視窗 -->
    <div id="victory-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 modal-backdrop">
        <div class="modal-card glass-panel border-2 border-amber-300/80 rounded-3xl max-w-md w-full p-6 sm:p-8 text-center relative overflow-hidden shadow-[0_0_50px_rgba(255,215,0,0.4)]">
            <!-- 頂部皇冠光芒 -->
            <div class="mx-auto w-16 h-16 rounded-full bg-gradient-to-tr from-amber-500 to-yellow-200 flex items-center justify-center shadow-[0_0_25px_rgba(255,215,0,0.8)] mb-4">
                <svg class="w-10 h-10 text-indigo-950" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
                </svg>
            </div>

            <h2 class="text-2xl sm:text-3xl font-black magic-title mb-1">魔法奇蹟達成！</h2>
            <p id="victory-subtitle" class="text-sm text-amber-100/90 mb-4">你成功喚醒了所有迪士尼星光夥伴！</p>

            <!-- 星級評價展示 -->
            <div id="victory-stars" class="flex items-center justify-center gap-2 my-3 text-4xl">
                <!-- 由 JS 動態填入星星 -->
            </div>

            <!-- 成績統計方塊 -->
            <div class="grid grid-cols-2 gap-3 my-5">
                <div class="bg-slate-900/70 border border-amber-400/30 rounded-2xl p-3">
                    <div class="text-xs text-blue-200/80 mb-1">總共耗時</div>
                    <div id="final-time" class="text-xl sm:text-2xl font-black text-sky-300 font-mono">00:00</div>
                </div>
                <div class="bg-slate-900/70 border border-amber-400/30 rounded-2xl p-3">
                    <div class="text-xs text-blue-200/80 mb-1">翻牌步數</div>
                    <div id="final-moves" class="text-xl sm:text-2xl font-black text-amber-300">0 步</div>
                </div>
            </div>

            <!-- 新紀錄徽章 -->
            <div id="new-record-badge" class="hidden mb-4 py-1 px-3 rounded-full bg-gradient-to-r from-pink-500/30 via-amber-400/30 to-pink-500/30 border border-amber-300/60 text-xs font-bold text-amber-200">
                🏆 恭喜刷新本難度最佳步數紀錄！
            </div>

            <button onclick="closeModalAndRestart()" class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500 text-indigo-950 font-black text-base sm:text-lg shadow-[0_0_20px_rgba(255,215,0,0.6)] hover:brightness-110 active:scale-95 transition-all">
                ✨ 再玩一次魔法挑戰 ✨
