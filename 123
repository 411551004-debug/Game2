        let currentDifficulty = 'normal';
        let flippedCards = [];
        let matchedPairs = 0;
        let moves = 0;
        let secondsElapsed = 0;
        let timerInterval = null;
        let isGameStarted = false;
        let isBoardLocked = false;

        // DOM 元素參照
        const gameBoard = document.getElementById('game-board');
        const statMoves = document.getElementById('stat-moves');
        const statTime = document.getElementById('stat-time');
        const statPairs = document.getElementById('stat-pairs');
        const statBest = document.getElementById('stat-best');
        const victoryModal = document.getElementById('victory-modal');

        /**
         * ==========================================
         * 4. 遊戲初始化與洗牌邏輯
         * ==========================================
         */
        function setDifficulty(diff) {
            if (currentDifficulty === diff && gameBoard.children.length > 0) return;
            currentDifficulty = diff;

            // 更新按鈕樣式
            ['easy', 'normal', 'hard'].forEach(key => {
                const btn = document.getElementById(`btn-${key}`);
                if (key === diff) {
                    btn.classList.add('active-diff');
                    btn.classList.remove('text-amber-100');
                } else {
                    btn.classList.remove('active-diff');
                    btn.classList.add('text-amber-100');
                }
            });

            restartGame();
        }

        function restartGame() {
            // 重置計時與狀態
            clearInterval(timerInterval);
            timerInterval = null;
            secondsElapsed = 0;
            moves = 0;
            matchedPairs = 0;
            flippedCards = [];
            isGameStarted = false;
            isBoardLocked = false;

            const config = DIFFICULTIES[currentDifficulty];
            updateStatsDisplay();
            loadBestScore();

            // 調整網格排版
            const mainContainer = gameBoard.parentElement;
            mainContainer.className = `relative z-10 w-full ${config.maxWidthClass} flex-1 flex items-center justify-center my-1`;
            gameBoard.className = `w-full grid ${config.colsClass} gap-2 sm:gap-3 transition-all duration-300`;

            // 挑選角色並成對複製後洗牌 (Fisher-Yates Shuffle)
            const selectedChars = DISNEY_CHARACTERS.slice(0, config.pairs);
            const deck = [...selectedChars, ...selectedChars];
            for (let i = deck.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [deck[i], deck[j]] = [deck[j], deck[i]];
            }

            // 渲染卡片 DOM
            gameBoard.innerHTML = '';
            deck.forEach((char, index) => {
                const cardEl = createCardElement(char, index);
                gameBoard.appendChild(cardEl);
            });
        }

        function createCardElement(char, index) {
            const scene = document.createElement('div');
            scene.className = 'card-scene';
            scene.dataset.characterId = char.id;
            scene.dataset.index = index;

            scene.innerHTML = `
                <div class="card-inner">
                    <!-- 牌背面：迪士尼魔法星光米奇徽章 -->
                    <div class="card-face card-back">
                        <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-amber-400/10 border border-amber-300/40 flex items-center justify-center shadow-[0_0_15px_rgba(255,215,0,0.2)]">
                            <svg viewBox="0 0 64 64" class="w-8 h-8 sm:w-10 sm:h-10 text-amber-300 drop-shadow-[0_0_6px_rgba(255,215,0,0.7)]" fill="currentColor">
                                <circle cx="18" cy="20" r="10"/>
                                <circle cx="46" cy="20" r="10"/>
                                <circle cx="32" cy="36" r="16"/>
                                <path d="M32 25l2 5h5l-4 3 1.5 5-4.5-3-4.5 3 1.5-5-4-3h5z" fill="#172554"/>
                            </svg>
                        </div>
                        <span class="mt-1.5 text-[10px] sm:text-xs tracking-widest text-amber-200/75 font-bold">DISNEY</span>
                    </div>

                    <!-- 牌正面：角色插畫與名稱標籤 -->
                    <div class="card-face card-front" style="background: ${char.bgGradient};">
                        <div class="w-full flex-1 flex items-center justify-center p-1 sm:p-2 overflow-hidden">
                            ${char.svg}
                        </div>
                        <div class="w-full py-1 px-1.5 rounded-lg text-center shadow-sm" style="background-color: ${char.badgeBg};">
                            <div class="text-xs sm:text-sm font-black text-white leading-tight tracking-wide truncate">
                                ${char.name}
                            </div>
                        </div>
                    </div>
                </div>
            `;

            scene.addEventListener('click', () => handleCardClick(scene));
            return scene;
        }

        /**
         * ==========================================
         * 5. 翻牌互動與配對判定邏輯
         * ==========================================
         */
        function handleCardClick(cardEl) {
            // 若面板鎖定、卡片已翻開或已配對則忽略點擊
            if (isBoardLocked) return;
            if (cardEl.classList.contains('is-flipped') || cardEl.classList.contains('is-matched')) return;

            // 首次翻牌時啟動計時器
            if (!isGameStarted) {
                isGameStarted = true;
                startTimer();
            }

            soundFX.playFlip();
            cardEl.classList.add('is-flipped');
            flippedCards.push(cardEl);

            if (flippedCards.length === 2) {
                moves++;
                updateStatsDisplay();
                checkForMatch();
            }
        }

        function checkForMatch() {
            isBoardLocked = true;
            const [card1, card2] = flippedCards;
            const isMatch = card1.dataset.characterId === card2.dataset.characterId;

            if (isMatch) {
                // 配對成功
                setTimeout(() => {
                    soundFX.playMatch();
                    card1.classList.add('is-matched');
                    card2.classList.add('is-matched');

                    // 在兩張卡片位置觸發星光粒子爆發
                    triggerCardSparkles(card1);
                    triggerCardSparkles(card2);

                    matchedPairs++;
                    updateStatsDisplay();
                    flippedCards = [];
                    isBoardLocked = false;

                    // 檢查是否全部配對完成
                    const totalPairs = DIFFICULTIES[currentDifficulty].pairs;
                    if (matchedPairs === totalPairs) {
                        handleGameVictory();
                    }
                }, 320);
            } else {
                // 配對失敗：稍微停留讓玩家記憶後翻回
                setTimeout(() => {
                    soundFX.playMismatch();
                    card1.classList.add('is-wrong');
                    card2.classList.add('is-wrong');
                }, 420);

                setTimeout(() => {
                    card1.classList.remove('is-flipped', 'is-wrong');
                    card2.classList.remove('is-flipped', 'is-wrong');
                    flippedCards = [];
                    isBoardLocked = false;
                }, 950);
            }
        }

        /**
         * ==========================================
         * 6. 計時器、最佳紀錄與過關慶祝
         * ==========================================
         */
        function startTimer() {
            timerInterval = setInterval(() => {
                secondsElapsed++;
                statTime.textContent = formatTime(secondsElapsed);
            }, 1000);
        }

        function formatTime(totalSeconds) {
            const mins = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
            const secs = (totalSeconds % 60).toString().padStart(2, '0');
            return `${mins}:${secs}`;
        }

        function updateStatsDisplay() {
            const totalPairs = DIFFICULTIES[currentDifficulty].pairs;
            statMoves.textContent = moves;
            statTime.textContent = formatTime(secondsElapsed);
            statPairs.textContent = `${matchedPairs} / ${totalPairs}`;
        }

        function loadBestScore() {
            try {
                const best = localStorage.getItem(`disney_memory_best_${currentDifficulty}`);
                statBest.textContent = best ? `${best} 步` : '--';
            } catch (e) {
                statBest.textContent = '--';
            }
        }

        function saveBestScoreIfBetter(currentMoves) {
            try {
                const key = `disney_memory_best_${currentDifficulty}`;
                const prevBest = localStorage.getItem(key);
                if (!prevBest || currentMoves < parseInt(prevBest, 10)) {
                    localStorage.setItem(key, currentMoves.toString());
                    statBest.textContent = `${currentMoves} 步`;
                    return true;
                }
            } catch (e) {
                // 忽略無痕模式儲存限制
            }
            return false;
        }

        function handleGameVictory() {
            clearInterval(timerInterval);
            setTimeout(() => {
                soundFX.playVictory();
                launchConfetti();

                const isNewRecord = saveBestScoreIfBetter(moves);
                const [threeStarLimit, twoStarLimit] = DIFFICULTIES[currentDifficulty].starThresholds;
                let starCount = 1;
                if (moves <= threeStarLimit) starCount = 3;
                else if (moves <= twoStarLimit) starCount = 2;

                // 渲染星級
                const starsContainer = document.getElementById('victory-stars');
                starsContainer.innerHTML = '';
                for (let i = 1; i <= 3; i++) {
                    const isEarned = i <= starCount;
                    const starSpan = document.createElement('span');
                    starSpan.textContent = '★';
                    starSpan.className = isEarned
                        ? 'text-amber-300 drop-shadow-[0_0_12px_rgba(255,215,0,0.9)] scale-110 transition-transform'
                        : 'text-slate-600';
                    starsContainer.appendChild(starSpan);
                }

                document.getElementById('final-time').textContent = formatTime(secondsElapsed);
                document.getElementById('final-moves').textContent = `${moves} 步`;

                const recordBadge = document.getElementById('new-record-badge');
                if (isNewRecord) {
                    recordBadge.classList.remove('hidden');
                } else {
                    recordBadge.classList.add('hidden');
                }

                victoryModal.classList.remove('hidden');
                victoryModal.classList.add('flex');
            }, 550);
        }

        function closeModalAndRestart() {
            victoryModal.classList.add('hidden');
            victoryModal.classList.remove('flex');
            stopConfetti();
            restartGame();
        }

        function toggleSound() {
            soundFX.muted = !soundFX.muted;
            document.getElementById('icon-sound-on').classList.toggle('hidden', soundFX.muted);
            document.getElementById('icon-sound-off').classList.toggle('hidden', !soundFX.muted);
            if (!soundFX.muted) {
                soundFX.playFlip();
            }
        }

        /**
         * ==========================================
         * 7. 星光粒子與慶祝彩帶視覺特效
         * ==========================================
         */
        function triggerCardSparkles(cardEl) {
            const rect = cardEl.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const colors = ['#ffd700', '#ffffff', '#7dd3fc', '#f472b6'];

            for (let i = 0; i < 12; i++) {
                const sparkle = document.createElement('div');
                sparkle.className = 'sparkle-burst';
                sparkle.innerHTML = '✦';
                sparkle.style.left = `${centerX}px`;
                sparkle.style.top = `${centerY}px`;
                sparkle.style.color = colors[i % colors.length];
                sparkle.style.fontSize = `${Math.random() * 14 + 12}px`;

                const angle = (Math.PI * 2 * i) / 12;
                const dist = 45 + Math.random() * 45;
                sparkle.style.setProperty('--tx', `${Math.cos(angle) * dist}px`);
                sparkle.style.setProperty('--ty', `${Math.sin(angle) * dist}px`);

                document.body.appendChild(sparkle);
                setTimeout(() => sparkle.remove(), 820);
            }
        }

        // 背景星夜粒子動畫
        function initStarfield() {
            const canvas = document.getElementById('starfield-canvas');
            const ctx = canvas.getContext('2d');
            let stars = [];

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
                stars = Array.from({ length: 85 }, () => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    r: Math.random() * 1.8 + 0.4,
                    alpha: Math.random(),
                    speed: Math.random() * 0.015 + 0.004,
                    driftY: -(Math.random() * 0.18 + 0.04)
                }));
            }

            window.addEventListener('resize', resize);
            resize();

            function render() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                stars.forEach(s => {
                    s.alpha += s.speed;
                    if (s.alpha > 1 || s.alpha < 0.15) s.speed = -s.speed;
                    s.y += s.driftY;
                    if (s.y < 0) s.y = canvas.height;

                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255, 243, 176, ${Math.max(0.1, Math.min(1, s.alpha))})`;
                    ctx.fill();
                });
                requestAnimationFrame(render);
            }
            render();
        }

        // 過關金色星光紙屑動畫
        let confettiAnimId = null;
        function launchConfetti() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const colors = ['#ffd700', '#ff6b6b', '#4ecdc4', '#a78bfa', '#f472b6', '#ffffff'];
            const pieces = Array.from({ length: 110 }, () => ({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height - canvas.height,
                w: Math.random() * 9 + 5,
                h: Math.random() * 6 + 4,
                color: colors[Math.floor(Math.random() * colors.length)],
                vy: Math.random() * 3 + 2,
                vx: (Math.random() - 0.5) * 2,
                rot: Math.random() * 360,
                rotSpeed: (Math.random() - 0.5) * 8
            }));

            function animateConfetti() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                pieces.forEach(p => {
                    p.y += p.vy;
                    p.x += p.vx;
                    p.rot += p.rotSpeed;
                    if (p.y > canvas.height) {
                        p.y = -15;
                        p.x = Math.random() * canvas.width;
                    }

                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate((p.rot * Math.PI) / 180);
                    ctx.fillStyle = p.color;
                    ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
                    ctx.restore();
                });
                confettiAnimId = requestAnimationFrame(animateConfetti);
            }
            animateConfetti();
        }

        function stopConfetti() {
            if (confettiAnimId) {
                cancelAnimationFrame(confettiAnimId);
                confettiAnimId = null;
            }
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        }

        // 網頁載入完成後啟動背景星光與初始化遊戲
        window.onload = function () {
            initStarfield();
            restartGame();
        };
    </script>
</body>
